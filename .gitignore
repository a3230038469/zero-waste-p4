# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
*.tsbuildinfo

# 环境变量（密钥！）
.env
.env.local
.env.*.local
!.env.example

# 数据库
*.db
*.db-journal
*.sqlite
*.sqlite3

# 日志
*.log
logs/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时
.tmp/
.tmp-cdp/
tmp/

# 本地资料包：PDF 原件体积大（35 份约 60MB），不进仓库
# 注意：同目录的 kb-index.json 与 README.md **要进**，前端靠索引开发
backend/data/kb/

# 埋点事件落库（每台机器各自的访客行为，属运行时数据；韶茹，2026-10-07）
backend/data/track/

# 访客反馈工单（可能含提交者留的邮箱/电话 = 个人信息，属运行时数据；
# 这是公开仓库，绝不可进版本库；2026-10-14）
backend/data/feedback.jsonl

# 问答设置（T3：老师后台选的回答模型/方式/强度，属本机运行状态，不进仓库）
backend/data/qa-settings.json

# 本机备份（含密钥 / 构建产物），绝不进仓库（2026-10-13 补）
backend/.env.bak-*
.demo-backup-*/
# 待审投稿文件与元数据（B09 公众上传：含投稿人手机号，绝不进仓库）
backend/data/contributions/

# T11：游客权限与游客提问计数属于**运行时状态**（与 qa-settings.json 同性质），不进仓库
# guest-ask-usage.json 内含 sha256(IP+UA) 的游客标识，更不该进
backend/data/guest-permissions.json
backend/data/guest-ask-usage.json

# 页面取证的过程产物（2026-10-18 首页改版审计，工具见 .agent/audit/tools/audit.mjs）
# chromium 临时用户目录 + 逐路由 dump + 整页长图：体积大（约 47MB）、可一条命令重跑，不进仓库。
# 结论与证据索引（*.md 与样板图）要进。
.agent/audit/chrome-profile*/
.agent/audit/**/*.dump.json
.agent/audit/shots/
.agent/audit/**/_*
# 第 3 批的验证截图目录（shots-verify / shots-b3 / shots-chat* …）同属过程产物，一并用通配收掉
.agent/audit/shots-*/
