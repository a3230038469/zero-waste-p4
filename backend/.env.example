# ===== WeKnora 引擎（内网，别暴露公网）=====
WEKNORA_BASE_URL=http://localhost:8080
WEKNORA_API_KEY=your_api_key_here
WEKNORA_KB_ID=your_knowledge_base_id_here
WEKNORA_CHANNEL_ID=your_embed_channel_id_here
WEKNORA_PUBLISH_TOKEN=your_publish_token_here

# ===== 自建后端 =====
PORT=4000
JWT_SECRET=please_generate_a_random_string
# 提问是否需要登录：false = 访客免注册可问（默认）
REQUIRE_LOGIN_FOR_ASK=false

# ===== 数据库（B02 用户板块：SQLite + Prisma）=====
DATABASE_URL="file:./dev.db"

# ===== 统计看板（B03 埋点统计）=====
# GET /api/track/stats 需带 X-Admin-Token 头；不配 = 看板一律 403（fail closed）
ADMIN_STATS_TOKEN=please_generate_a_random_string
