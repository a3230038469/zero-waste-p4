// 数据库模型 —— 负责人：月月（B02 用户板块）
// SQLite + Prisma（见《公共约定》技术栈）。
//
// 拉取代码后初始化（在 backend 目录执行一次）：
//   npm install
//   npm run db:generate   # 生成 Prisma Client
//   npm run db:push       # 建表（生成 prisma/dev.db，*.db 已在 .gitignore）
//
// DATABASE_URL 在 backend/.env 配置，占位示例见 backend/.env.example。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 注册用户（B02：五个注册字段 + 密码哈希）
/// 密码只存 bcrypt 哈希（passwordHash），绝不存明文。
/// topics 为关注议题：SQLite 无数组类型，存 JSON 数组字符串，接口层还原为数组。
///
/// role（2026-10-19 新增）：身份。取值只有两个 ——
///   "user"  普通用户（默认，所有人注册都是这个）
///   "admin" 管理员（能进 /admin 管理台；用 `npm run admin:role -- grant 手机号` 授予）
/// 为什么加它：管理接口原来靠 backend/.env 里的一把共用口令（ADMIN_STATS_TOKEN）挡门，
/// 换电脑/换浏览器就要重贴，也查不到是谁改的。改成账号身份后：
/// 一次登录、按身份放行、谁改的有据可查。**默认值必须是 "user"**，
/// 绝不能让「注册即管理员」这种口子存在。
model User {
  id           String   @id @default(cuid())
  name         String // 姓名
  org          String // 机构
  occupation   String // 职业
  topics       String // 关注议题（JSON 数组字符串）
  phone        String   @unique // 电话（唯一）
  passwordHash String // 密码哈希（bcrypt）
  role         String   @default("user") // 身份：user | admin
  createdAt    DateTime @default(now())
}

/// 站点信息（2026-10-19 新增）—— 交给基金会自己填的对外口径
///
/// 为什么用 key-value 而不是一堆列：这些字段会变（今天要联系方式/邮箱/地址，
/// 明天可能要加「合作说明」「页脚版权」），key-value 加字段不用再改表结构。
/// 已知 key 见 backend/src/site/info.ts 的 SITE_INFO_FIELDS：
///   contact / email / address / cooperation / copyright
/// 约定：**空值就是不填**，接口照实返回空串，前端继续显示「待补充」占位——
/// 未由基金会确认的对外口径一个字都不许编（见根 AGENTS.md）。
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 对话会话（T5 · 乙方案：会话存数据库，刷新页面能恢复画面）
///
/// engineSessionId 是**引擎侧**的 session id：
/// 问答时复用同一个 session，AI 才记得这个对话前面说过什么；
/// 这个值只落在后端库里，**绝不返回给前端**（与 ask.ts「会话 id 服务端持有」一致）。
/// 建会话时引擎若不可用（密钥未到位 / 额度 429），它会是 null，
/// 提问时再懒建一次补上，不让引擎抖动把「建会话」这个动作整个废掉。
model Conversation {
  id              String   @id @default(uuid())
  title           String   @default("新对话")
  engineSessionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        Message[]
}

/// 一条对话消息（T5）
/// role: "user" | "assistant"；sources 为 JSON 字符串（T4 来源卡片 [{name,url}]，仅 assistant 有）。
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  sources        String?
  createdAt      DateTime     @default(now())
}
